# Copy to .env and fill in. Every key is optional: without any model provider
# key the app runs in mock mode so you can click through the whole UI.

# ── Model providers ─────────────────────────────────────────────────────
# Set one or more. Each bot picks one model; when it fails (rate limit,
# outage), the bot falls back to another provider that has a key.
# All four have free tiers or free models at the time of writing.

# Google Gemini (https://aistudio.google.com/apikey). GOOGLE_GENERATIVE_AI_API_KEY also works.
GEMINI_API_KEY=
# Groq: fast open models (https://console.groq.com/keys)
GROQ_API_KEY=
# OpenRouter: includes free models ending in ":free" (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Nebius Token Factory: open-source models (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=

# Optional: the model new bots start with. Must start with its provider.
# Default: the recommended model of the first provider above that has a key.
# OPENCREWBOT_DEFAULT_MODEL=google/gemini-2.5-flash

# Optional: force the scripted mock model even when keys are set (demos, tests).
# OPENCREWBOT_MOCK_MODE=true

# Web search, page extract and site crawl tools (https://app.tavily.com)
TAVILY_API_KEY=

# Cloud browser for bots with the Browser tool (https://www.browserbase.com)
BROWSERBASE_API_KEY=
# Optional: the project is inferred from the key when this is empty.
# BROWSERBASE_PROJECT_ID=
# Optional: how long one bot's browser session may run (default 15).
# BROWSERBASE_SESSION_MINUTES=15

# Connected apps: Slack, GitHub, Gmail, Notion and 1,000+ more (https://platform.composio.dev)
# Use a PROJECT API key (your project → Settings → API Keys). Connections shows
# "NOT WORKING" with the reason if Composio rejects it.
COMPOSIO_API_KEY=

# Room routing: Jev, TypeSafe's decision model, picks who answers in Auto rooms.
# Without it, Auto rooms fall back to the room's lead bot. This is a TypeSafe
# key (https://typesafe.ai), not an OpenRouter key.
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest

# Where bots, chats and MEMORY.md files live (default: ./data)
# OPENCREWBOT_DATA_DIR=./data

# Where the skills library lives: one folder per skill with a SKILL.md (default: ./skills)
# OPENCREWBOT_SKILLS_DIR=./skills

# ── Team plans (execution engine) ───────────────────────────────────────
# How many plan tasks run at the same time, across all runs (default 3).
# Kept small because free tiers limit requests and tokens per minute.
# OPENCREWBOT_MAX_PARALLEL_TASKS=3
# How long one attempt of a task may run before it's stopped (default 15).
# Waiting for your approval counts towards it.
# OPENCREWBOT_TASK_TIMEOUT_MINUTES=15

# ── Collaboration and evidence ──────────────────────────────────────────
# Tokens teammates' answers (ask_teammate) may use on one piece of work (default 200000).
# OPENCREWBOT_COLLAB_TOKEN_BUDGET=200000
# Where "Save as evidence" writes demonstration evidence (default: ./evidence)
# OPENCREWBOT_EVIDENCE_DIR=./evidence
